@page
@model ApplyWise.Web.Areas.Identity.Pages.Account.ResetPasswordModel
@using ApplyWise.Web.Services.AccountSecurity
@{
    ViewData["Title"] = "Choose a new password";
    ViewData["MetaDescription"] = "Verify your ApplyWise reset code and choose a new password.";
}

<div class="aw-auth-shell aw-auth-shell-reset aw-fade-in">
    <section class="aw-login-card aw-reset-card aw-slide-up" aria-labelledby="reset-password-title">
        <header class="aw-login-heading">
            <span class="aw-auth-kicker"><svg class="ui-icon"><use href="#i-settings" /></svg>Secure password reset</span>
            <h1 id="reset-password-title">Choose a new password</h1>
            @if (Model.IsLegacyLink)
            {
                <p>Confirm your email address, then create a password you do not use elsewhere.</p>
            }
            else
            {
                <p>Enter the code sent to <strong>@Model.Input.Email</strong>, then create a new password.</p>
            }
        </header>

        @if (!string.IsNullOrWhiteSpace(Model.DeliveryMessage))
        {
            <div class="aw-auth-status-callout" role="status">@Model.DeliveryMessage</div>
        }

        <form method="post" class="aw-login-form">
            <input asp-for="Input.LegacyToken" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation-summary aw-login-alert" role="alert"></div>

            @if (Model.IsLegacyLink)
            {
                <label class="aw-login-field" asp-for="Input.Email">
                    <span>Email address</span>
                    <span class="aw-login-input">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v12H4zM4 7l8 6 8-6" /></svg>
                        <input asp-for="Input.Email" autocomplete="email" placeholder="you@example.com" autofocus />
                    </span>
                    <span asp-validation-for="Input.Email" class="field-validation-error"></span>
                </label>
            }
            else
            {
                <input asp-for="Input.Email" type="hidden" />
                <label class="aw-login-field" asp-for="Input.Code">
                    <span>Six-digit reset code</span>
                    <span class="aw-login-input aw-security-code-wrap">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="3" /><path d="M8 9h.01M12 9h.01M16 9h.01M8 14h8" /></svg>
                        <input asp-for="Input.Code"
                               class="aw-security-code-input"
                               inputmode="numeric"
                               pattern="[0-9]{6}"
                               maxlength="6"
                               autocomplete="one-time-code"
                               placeholder="000000"
                               data-security-code
                               autofocus />
                    </span>
                    <span asp-validation-for="Input.Code" class="field-validation-error"></span>
                </label>
            }

            <div class="aw-login-field">
                <label class="aw-login-field-label" asp-for="Input.Password">New password</label>
                <span class="aw-login-input">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
                    <input asp-for="Input.Password" autocomplete="new-password" placeholder="Create a secure password" aria-describedby="reset-password-requirements" />
                    <partial name="_PasswordToggle" model='"Input_Password"' />
                </span>
                <small id="reset-password-requirements" class="aw-password-help">@PasswordRequirements.UserFacingSummary</small>
                <span asp-validation-for="Input.Password" class="field-validation-error"></span>
            </div>

            <div class="aw-login-field">
                <label class="aw-login-field-label" asp-for="Input.ConfirmPassword">Confirm new password</label>
                <span class="aw-login-input">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
                    <input asp-for="Input.ConfirmPassword" autocomplete="new-password" placeholder="Repeat your new password" />
                    <partial name="_PasswordToggle" model='"Input_ConfirmPassword"' />
                </span>
                <span asp-validation-for="Input.ConfirmPassword" class="field-validation-error"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-lg aw-login-submit">
                Save new password <svg class="ui-icon"><use href="#i-arrow" /></svg>
            </button>
        </form>

        @if (!Model.IsLegacyLink)
        {
            <form method="post" asp-page-handler="Resend" class="aw-auth-secondary-form">
                <input type="hidden" name="email" value="@Model.Input.Email" />
                <button type="submit" class="btn btn-link">Send a new code</button>
                <span aria-hidden="true">·</span>
                <a asp-page="./ForgotPassword">Use another email</a>
            </form>
        }
        else
        {
            <a class="aw-recovery-back" asp-page="./ForgotPassword">
                <span aria-hidden="true">←</span> Request a new reset code
            </a>
        }
    </section>

    <aside class="aw-auth-visual" aria-label="Wiso helping you choose a new password">
        <div class="aw-auth-quote">
            <span class="aw-auth-kicker">Protect your progress</span>
            <blockquote>Reset the password, not the progress you've made.</blockquote>
            <p>Your applications, resume versions, interviews, and insights will be waiting when you sign back in.</p>
        </div>
        <div class="aw-auth-avatar-wrap">
            <span>Almost there!</span>
            <img src="~/images/wiso.jpg" width="620" height="620" decoding="async" alt="Wiso supporting a secure password reset" />
        </div>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
