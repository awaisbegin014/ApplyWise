@page
@model ApplyWise.Web.Areas.Identity.Pages.Account.RegisterConfirmationModel
@{
    ViewData["Title"] = Model.Succeeded ? "Email confirmed" : "Verify your email";
    ViewData["MetaDescription"] = "Enter your ApplyWise verification code to confirm your account.";
}

<div class="aw-auth-shell aw-auth-shell-code aw-fade-in">
    <section class="aw-login-card aw-code-card aw-slide-up" aria-labelledby="registration-confirmation-title">
        @if (Model.Succeeded)
        {
            <span class="aw-auth-kicker"><svg class="ui-icon"><use href="#i-mail" /></svg>Email verified</span>
            <span class="aw-auth-status-icon aw-auth-status-icon-success" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /></svg>
            </span>
            <h1 id="registration-confirmation-title">Your account is ready</h1>
            <p>@Model.DeliveryMessage</p>
            <a class="btn btn-primary btn-lg aw-login-submit" href="@Model.LoginUrl">Continue to login</a>
        }
        else
        {
            <header class="aw-login-heading">
                <span class="aw-auth-kicker"><svg class="ui-icon"><use href="#i-mail" /></svg>Secure your account</span>
                <h1 id="registration-confirmation-title">Verify and secure your account</h1>
                <p>Enter the six-digit code, then choose the password that will own this account. The code expires in 10 minutes.</p>
            </header>

            @if (!string.IsNullOrWhiteSpace(Model.DeliveryMessage))
            {
                <div class="aw-auth-status-callout" role="status">@Model.DeliveryMessage</div>
            }

            <form method="post" class="aw-login-form">
                <input asp-for="Input.Email" type="hidden" />
                <input asp-for="Input.ReturnUrl" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="validation-summary aw-login-alert" role="alert"></div>

                <label class="aw-login-field" asp-for="Input.Code">
                    <span>Six-digit code</span>
                    <span class="aw-login-input aw-security-code-wrap">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="3" /><path d="M8 9h.01M12 9h.01M16 9h.01M8 14h8" /></svg>
                        <input asp-for="Input.Code"
                               class="aw-security-code-input"
                               inputmode="numeric"
                               pattern="[0-9]{6}"
                               maxlength="6"
                               autocomplete="one-time-code"
                               placeholder="000000"
                               data-security-code
                               autofocus />
                    </span>
                    <span asp-validation-for="Input.Code" class="field-validation-error"></span>
                </label>

                <div class="aw-login-field">
                    <label class="aw-login-field-label" asp-for="Input.Password">Choose your password</label>
                    <span class="aw-login-input">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
                        <input asp-for="Input.Password" autocomplete="new-password" placeholder="Create a secure password" aria-describedby="confirmation-password-requirements" />
                        <partial name="_PasswordToggle" model='"Input_Password"' />
                    </span>
                    <small id="confirmation-password-requirements" class="aw-password-help">@ApplyWise.Web.Services.AccountSecurity.PasswordRequirements.UserFacingSummary</small>
                    <span asp-validation-for="Input.Password" class="field-validation-error"></span>
                </div>

                <div class="aw-login-field">
                    <label class="aw-login-field-label" asp-for="Input.ConfirmPassword">Confirm your password</label>
                    <span class="aw-login-input">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
                        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" placeholder="Repeat your secure password" />
                        <partial name="_PasswordToggle" model='"Input_ConfirmPassword"' />
                    </span>
                    <span asp-validation-for="Input.ConfirmPassword" class="field-validation-error"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-lg aw-login-submit">
                    Verify and secure account <svg class="ui-icon"><use href="#i-arrow" /></svg>
                </button>
            </form>

            <form method="post" asp-page-handler="Resend" class="aw-auth-secondary-form">
                <input type="hidden" name="email" value="@Model.Input.Email" />
                <input type="hidden" name="returnUrl" value="@Model.Input.ReturnUrl" />
                <button type="submit" class="btn btn-link">Send a new code</button>
                <span aria-hidden="true">·</span>
                <a asp-page="./Login" asp-route-returnUrl="@Model.Input.ReturnUrl">Back to login</a>
            </form>

            <p class="aw-auth-status-hint">No email yet? Check spam, then wait one minute before requesting another code.</p>
        }
    </section>

    <aside class="aw-auth-visual" aria-label="Wiso helping you secure your ApplyWise account">
        <div class="aw-auth-quote">
            <span class="aw-auth-kicker">A secure beginning</span>
            <blockquote>Every strong application starts with a trusted account.</blockquote>
            <p>One quick verification keeps your private resumes and job-search activity connected to you.</p>
        </div>
        <div class="aw-auth-avatar-wrap">
            <span>@(Model.Succeeded ? "You're verified!" : "Check your inbox!")</span>
            <img src="~/images/wiso.jpg" width="620" height="620" decoding="async" alt="Wiso helping with email verification" />
        </div>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
