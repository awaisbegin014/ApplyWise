{
  "Identity": { "RequireConfirmedAccount": true },
  "AdminAccess": {
    "Emails": [ "__SET_OWNER_EMAIL__" ],
    "RequireMfa": true
  },
  "ProductEvents": { "RetentionDays": 90 },
  "HumanChallenge": {
    "Enabled": true,
    "SiteKey": "__SET_TURNSTILE_SITE_KEY__",
    "SecretKey": "__SET_TURNSTILE_SECRET_KEY__",
    "ExpectedHostname": "__SET_PUBLIC_HOST__"
  },
  "PublicOrigin": "https://__SET_PUBLIC_HOST__",
  "AllowedHosts": "__SET_PUBLIC_HOST__",
  "ResumeStorage": { "RootPath": "__SET_PRIVATE_RESUME_STORAGE_PATH__" },
  "DataProtection": {
    "KeysPath": "__SET_PERSISTENT_DATA_PROTECTION_KEY_PATH__",
    "CertificatePath": "__SET_DATA_PROTECTION_CERTIFICATE_PATH__",
    "CertificatePassword": "__SET_DATA_PROTECTION_CERTIFICATE_PASSWORD__",
    "PreviousCertificates": []
  },
  "Email": { "Host": "__SET_SMTP_HOST__", "From": "__SET_FROM_ADDRESS__" },
  "Google": {
    "ClientId": "",
    "ClientSecret": "",
    "GmailImportEnabled": true,
    "GmailAutoSyncEnabled": true
  },
  "Gemini": {
    "Enabled": false,
    "ApiKey": "",
    "Model": "gemini-2.5-flash-lite",
    "TimeoutSeconds": 30,
    "MaxOutputTokens": 900
  },
  "Subscriptions": {
    "FreeAiTrialLimit": 2,
    "ProMonthlyAiLimit": 100,
    "ProDurationDays": 30,
    "ProPrice": 500,
    "Currency": "PKR",
    "PaymentInstructions": "Complete your payment using the published ApplyWise payment account, then submit the transaction reference for manual verification."
  },
  "ForwardedHeaders": {
    "KnownProxies": [ "__SET_TRUSTED_PROXY_IP__" ]
  },
  "ConnectionStrings": { "DefaultConnection": "__SET_CONNECTION_STRING__" },
  "SqlTransport": {
    "AllowMonsterAspManagedCertificate": false,
    "MonsterAspHost": ""
  }
}
