@model ApplyWise.Web.ViewModels.JobScamChecks.JobScamCheckHistoryViewModel
@{ ViewData["Title"] = "Scam Check History"; }
<div class="page-heading"><div><h1>Job-post review history</h1><p>Review previous rule-based job-post checks.</p></div><a class="btn btn-outline-secondary" asp-controller="JobApplications" asp-action="Index">Applications</a></div>
@if (Model.Checks.Count == 0) { <section class="panel empty-state"><span class="empty-icon">!</span><h3>No job-post reviews yet</h3><p>Run a review from a job application to check potential red flags.</p><a class="btn btn-primary" asp-controller="JobApplications" asp-action="Index">View applications</a></section> }
else
{
    <section class="panel analysis-history-panel">
        <div class="resume-list-header"><span>@Model.TotalCount saved check@(Model.TotalCount == 1 ? string.Empty : "s")</span><span>Private to your account</span></div>
        <div class="table-responsive"><table class="table app-table scam-history-table"><thead><tr><th>Date</th><th>Job</th><th>Risk</th><th>Quality</th><th><span class="visually-hidden">Actions</span></th></tr></thead><tbody>@foreach (var check in Model.Checks) { <tr><td data-label="Date">@check.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</td><td data-label="Job"><div class="application-role"><strong>@check.JobTitle</strong><span>@check.CompanyName</span></div></td><td data-label="Risk"><span class="badge @RiskBadge(check.RiskLevel)">@check.RiskScore · @check.RiskLevel.GetDisplayName()</span></td><td data-label="Quality">@check.QualityScore%</td><td data-label="Action" class="text-end"><a asp-action="Details" asp-route-id="@check.Id">View</a></td></tr> }</tbody></table></div>
        @if (Model.TotalPages > 1)
        {
            <nav class="pagination-nav" aria-label="Job-post review history pages">
                @if (Model.HasPreviousPage) { <a class="btn btn-outline-secondary btn-sm" asp-action="History" asp-route-page="@(Model.Page - 1)">Previous</a> }
                <span aria-current="page">Page @Model.Page of @Model.TotalPages</span>
                @if (Model.HasNextPage) { <a class="btn btn-outline-secondary btn-sm" asp-action="History" asp-route-page="@(Model.Page + 1)">Next</a> }
            </nav>
        }
    </section>
}
@functions { private static string RiskBadge(JobRiskLevel level) => level switch { JobRiskLevel.High => "status-rejected", JobRiskLevel.Medium => "status-interview", _ => "status-offer" }; }
