@using ApplyWise.Web.Services.Admin
@using Microsoft.Extensions.Options
@inject IOptions<AdminAccessOptions> AdminOptions
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var authenticatedEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
        ?? User.Identity?.Name;
    var isAdmin = User.IsInRole(AdminAccess.Role)
        || AdminOptions.Value.Contains(authenticatedEmail);
    var isIdentityPage = string.Equals(ViewContext.RouteData.Values["area"]?.ToString(), "Identity", StringComparison.OrdinalIgnoreCase);
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isMarketingPage = !isIdentityPage
        && ((string.Equals(controller, "Home", StringComparison.OrdinalIgnoreCase)
            && (string.Equals(action, "Index", StringComparison.OrdinalIgnoreCase)
                || string.Equals(action, "JobTracker", StringComparison.OrdinalIgnoreCase)
                || string.Equals(action, "ResumeMatch", StringComparison.OrdinalIgnoreCase)
                || string.Equals(action, "ResumeBuilder", StringComparison.OrdinalIgnoreCase)
                || string.Equals(action, "HowItWorks", StringComparison.OrdinalIgnoreCase)))
            || string.Equals(controller, "Contact", StringComparison.OrdinalIgnoreCase));
    var isAdminContactPage = string.Equals(controller, "Admin", StringComparison.OrdinalIgnoreCase)
        && action is "ContactMessages" or "ContactMessage" or "SetContactMessageReadState";
    var isAdminConsolePage = string.Equals(controller, "Admin", StringComparison.OrdinalIgnoreCase)
        && !isAdminContactPage;
    var metaDescription = ViewData["MetaDescription"]?.ToString()
        ?? "ApplyWise helps job seekers track applications, choose the right resume, and apply smarter.";
}
<!DOCTYPE html>
<html lang="en" data-authenticated-workspace="@(isAuthenticated ? "true" : "false")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@metaDescription" />
    <title>@ViewData["Title"] - ApplyWise</title>
    <link rel="icon" type="image/png" href="~/images/applywise-logo-v2.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/images/applywise-logo-v2.png" asp-append-version="true" />
    <script>
        try {
            const workspace = document.documentElement.dataset.authenticatedWorkspace === 'true';
            const paletteVersion = 'light-blue-v1';
            if (workspace && localStorage.getItem('applywise-palette-version') !== paletteVersion) {
                localStorage.setItem('applywise-theme', 'light');
                localStorage.setItem('applywise-palette-version', paletteVersion);
            }
            const saved = workspace ? localStorage.getItem('applywise-theme') : null;
            const theme = workspace && saved === 'dark' ? 'dark' : 'light';
            document.documentElement.dataset.theme = theme;
            document.documentElement.style.colorScheme = theme;
        } catch {
            document.documentElement.dataset.theme = 'light';
            document.documentElement.style.colorScheme = 'light';
        }
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/release.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
</head>
<body class="@(isMarketingPage ? "public-body home-body" : isAuthenticated ? "app-body" : isIdentityPage ? "public-body identity-body" : "public-body")">
<svg class="icon-sprite" aria-hidden="true">
    <symbol id="i-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/></symbol>
    <symbol id="i-briefcase" viewBox="0 0 24 24"><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 10h18M5 7h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2Z"/></symbol>
    <symbol id="i-file" viewBox="0 0 24 24"><path d="M6 2h8l4 4v16H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Z"/><path d="M14 2v5h5M8 12h8M8 16h6"/></symbol>
    <symbol id="i-edit-file" viewBox="0 0 24 24"><path d="M6 2h8l4 4v5M14 2v5h5M8 12h4"/><path d="m13 19 6.7-6.7a1.4 1.4 0 0 1 2 2L15 21l-3 .8.8-2.8Z"/></symbol>
    <symbol id="i-match" viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"/><path d="M14 3v5h5M8 13l2.2 2.2L15 10.5M8 18h7"/></symbol>
    <symbol id="i-mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></symbol>
    <symbol id="i-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01"/></symbol>
    <symbol id="i-settings" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-2.8 2.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2h-4V21a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1L4.2 17l.1-.1a1.7 1.7 0 0 0 .3-1.9A1.7 1.7 0 0 0 3 14H2.8v-4H3a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9L4.2 7 7 4.2l.1.1a1.7 1.7 0 0 0 1.9.3A1.7 1.7 0 0 0 10 3V2.8h4V3a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1L19.8 7l-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.2v4H21a1.7 1.7 0 0 0-1.6 1Z"/></symbol>
    <symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></symbol>
    <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
    <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></symbol>
    <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14M14 7l5 5-5 5"/></symbol>
</svg>
<a class="skip-link" href="#main-content">Skip to main content</a>
@if (isAuthenticated && !isMarketingPage)
{
    <div class="app-shell">
        <aside class="app-sidebar" id="appSidebar">
            @if (isAdmin)
            {
                <a class="brand" asp-controller="Admin" asp-action="Index"><img class="brand-mark" src="~/images/applywise-logo-v2.png" width="34" height="34" alt="" /><span>ApplyWise</span></a>
            }
            else
            {
                <a class="brand" asp-controller="Dashboard" asp-action="Index"><img class="brand-mark" src="~/images/applywise-logo-v2.png" width="34" height="34" alt="" /><span>ApplyWise</span></a>
                <a class="btn btn-primary sidebar-primary-action" asp-controller="JobApplications" asp-action="Create"><svg class="ui-icon" aria-hidden="true"><use href="#i-plus" /></svg><span>Add application</span></a>
            }
            <nav class="sidebar-nav" aria-label="Main navigation">
                @if (isAdmin)
                {
                    <a class="@(isAdminConsolePage ? "active" : null)" aria-current="@(isAdminConsolePage ? "page" : null)" asp-controller="Admin" asp-action="Index"><svg class="ui-icon"><use href="#i-grid" /></svg>Owner console</a>
                    <a class="@(isAdminContactPage ? "active" : null)" aria-current="@(isAdminContactPage ? "page" : null)" asp-controller="Admin" asp-action="ContactMessages"><svg class="ui-icon"><use href="#i-mail" /></svg>Contact inbox</a>
                    <a class="@(controller == "Dashboard" && action == "Settings" ? "active" : null)" aria-current="@(controller == "Dashboard" && action == "Settings" ? "page" : null)" asp-controller="Dashboard" asp-action="Settings"><svg class="ui-icon"><use href="#i-settings" /></svg>Owner security</a>
                }
                else
                {
                    <div class="sidebar-nav-group" role="group" aria-labelledby="nav-track-label">
                        <span class="sidebar-nav-label" id="nav-track-label">Track</span>
                        <a class="@(controller == "Dashboard" && action != "Settings" ? "active" : null)" aria-current="@(controller == "Dashboard" && action != "Settings" ? "page" : null)" asp-controller="Dashboard" asp-action="Index"><svg class="ui-icon"><use href="#i-grid" /></svg>Dashboard</a>
                        <a class="@(controller == "JobApplications" ? "active" : null)" aria-current="@(controller == "JobApplications" ? "page" : null)" asp-controller="JobApplications" asp-action="Index"><svg class="ui-icon"><use href="#i-briefcase" /></svg>Applications</a>
                        <a class="@(controller is "ApplicationImports" or "GmailConnections" ? "active" : null)" aria-current="@(controller is "ApplicationImports" or "GmailConnections" ? "page" : null)" asp-controller="ApplicationImports" asp-action="Index"><svg class="ui-icon"><use href="#i-mail" /></svg>Imports</a>
                        <a class="@(controller == "Interviews" ? "active" : null)" aria-current="@(controller == "Interviews" ? "page" : null)" asp-controller="Interviews" asp-action="Index"><svg class="ui-icon"><use href="#i-calendar" /></svg>Interviews</a>
                    </div>
                    <div class="sidebar-nav-group" role="group" aria-labelledby="nav-resume-label">
                        <span class="sidebar-nav-label" id="nav-resume-label">Resume</span>
                        <a class="@(controller == "Resumes" ? "active" : null)" aria-current="@(controller == "Resumes" ? "page" : null)" asp-controller="Resumes" asp-action="Index"><svg class="ui-icon"><use href="#i-file" /></svg>Resume library</a>
                        <a class="@(controller == "ResumeBuilder" ? "active" : null)" aria-current="@(controller == "ResumeBuilder" ? "page" : null)" asp-controller="ResumeBuilder" asp-action="Index"><svg class="ui-icon"><use href="#i-edit-file" /></svg>Resume builder</a>
                        <a class="@(controller is "ResumeAnalyzer" or "BestResumePicker" ? "active" : null)" aria-current="@(controller is "ResumeAnalyzer" or "BestResumePicker" ? "page" : null)" asp-controller="ResumeAnalyzer" asp-action="Index"><svg class="ui-icon"><use href="#i-match" /></svg>Resume tools</a>
                    </div>
                    <div class="sidebar-nav-group" role="group" aria-labelledby="nav-account-label">
                        <span class="sidebar-nav-label" id="nav-account-label">Account</span>
                        <a class="@(controller == "Profile" ? "active" : null)" aria-current="@(controller == "Profile" ? "page" : null)" asp-controller="Profile" asp-action="Index"><svg class="ui-icon"><use href="#i-user" /></svg>Profile</a>
                        <a class="@(controller == "Dashboard" && action == "Settings" ? "active" : null)" aria-current="@(controller == "Dashboard" && action == "Settings" ? "page" : null)" asp-controller="Dashboard" asp-action="Settings"><svg class="ui-icon"><use href="#i-settings" /></svg>Settings</a>
                    </div>
                }
            </nav>
            @if (!isAdmin)
            {
                <div class="sidebar-guide">
                    <img src="~/images/wiso.jpg" width="40" height="40" alt="" />
                    <span><strong>Private workspace</strong><small>Your resumes and job-search data stay tied to your account.</small></span>
                </div>
            }
        </aside>
        <div class="app-main">
            <header class="topbar">
                <button class="menu-button" type="button" data-sidebar-toggle aria-label="Close navigation sidebar" title="Close navigation sidebar" aria-controls="appSidebar" aria-expanded="true"><span></span><span></span><span></span></button>
                <div class="topbar-actions">
                    <partial name="_LoginPartial" />
                </div>
            </header>
            <main class="app-content" id="main-content" role="main">@RenderBody()</main>
        </div>
        <button class="sidebar-backdrop" type="button" data-sidebar-toggle aria-label="Close navigation"></button>
    </div>
}
else
{
    @if (isMarketingPage)
    {
        <header class="public-header aw-public-header" data-home-header>
            <div class="aw-home-nav-shell">
                <a class="brand aw-home-brand" asp-controller="Home" asp-action="Index" aria-label="ApplyWise home"><img class="brand-mark" src="~/images/applywise-logo-v2.png" width="34" height="34" alt="" /><span class="visually-hidden">ApplyWise</span></a>
                <button class="aw-home-nav-toggle" type="button" aria-expanded="false" aria-controls="public-navigation" aria-label="Open navigation" data-home-nav-toggle hidden>
                    <span></span><span></span><span></span>
                </button>
                <nav class="aw-home-nav" id="public-navigation" aria-label="Primary navigation" data-home-nav>
                    <div class="aw-home-nav-links">
                        <a asp-controller="Home" asp-action="JobTracker" aria-current="@(action == "JobTracker" ? "page" : null)">Job tracker</a>
                        <a asp-controller="Home" asp-action="ResumeMatch" aria-current="@(action == "ResumeMatch" ? "page" : null)">Resume match</a>
                        <a asp-controller="Home" asp-action="ResumeBuilder" aria-current="@(action == "ResumeBuilder" ? "page" : null)">Resume builder</a>
                        <a asp-controller="Home" asp-action="HowItWorks" aria-current="@(action == "HowItWorks" ? "page" : null)">How it works</a>
                        <a asp-controller="Contact" asp-action="Index" aria-current="@(controller == "Contact" ? "page" : null)">Contact us</a>
                    </div>
                    <div class="aw-home-nav-actions">
                        @if (isAuthenticated)
                        {
                            <a class="aw-home-sign-in" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                            <a class="btn aw-home-nav-cta" asp-controller="JobApplications" asp-action="Create">Add application</a>
                        }
                        else
                        {
                            <a class="aw-home-sign-in" asp-area="Identity" asp-page="/Account/Login">Sign in</a>
                            <a class="btn aw-home-nav-cta" asp-area="Identity" asp-page="/Account/Register">Start tracking</a>
                        }
                    </div>
                </nav>
            </div>
        </header>
        @RenderBody()
    }
    else
    {
        <header class="public-header public-header-compact">
            <a class="brand" asp-controller="Home" asp-action="Index"><img class="brand-mark" src="~/images/applywise-logo-v2.png" width="34" height="34" alt="" /><span>ApplyWise</span></a>
        </header>
        <main id="main-content" role="main">@RenderBody()</main>
    }
    @if (!isMarketingPage)
    {
        <footer class="public-footer">
            <nav aria-label="Legal and support">
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                <a asp-controller="Home" asp-action="Terms">Terms</a>
                <a asp-controller="Home" asp-action="Support">Support</a>
                <a asp-controller="Contact" asp-action="Index">Contact us</a>
            </nav>
            <span>&copy; @DateTime.UtcNow.Year ApplyWise</span>
        </footer>
    }
}
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
