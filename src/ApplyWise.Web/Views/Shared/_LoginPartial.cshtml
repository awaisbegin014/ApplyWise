@using Microsoft.AspNetCore.Identity
@using ApplyWise.Web.Services.Admin
@using Microsoft.Extensions.Options
@inject SignInManager<IdentityUser> SignInManager
@inject IOptions<AdminAccessOptions> AdminOptions
@{
    var displayName = User.FindFirst("display_name")?.Value;
    displayName = string.IsNullOrWhiteSpace(displayName)
        ? User.Identity?.Name?.Split('@')[0] ?? "User"
        : displayName.Trim();
    var authenticatedEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
        ?? User.Identity?.Name;
    var isAdmin = User.IsInRole(AdminAccess.Role)
        || AdminOptions.Value.Contains(authenticatedEmail);
}
<div class="account-links">
@if (SignInManager.IsSignedIn(User)) {
    <div class="account-menu" data-account-menu>
        <button class="account-menu-trigger" type="button" data-account-menu-trigger aria-expanded="false" aria-controls="account-menu-panel" title="Open account options">
            <span class="account-avatar">
                <span class="account-avatar-fallback" aria-hidden="true">@displayName[0].ToString().ToUpperInvariant()</span>
                @if (!isAdmin)
                {
                    <img src="@(Url.Action("Avatar", "Profile", new { version = DateTimeOffset.UtcNow.ToUnixTimeSeconds() }) ?? "/profile/avatar")" alt="Your profile picture" onerror="this.hidden=true;" />
                }
            </span>
            <span class="visually-hidden">Open account options</span>
        </button>
        <div class="account-menu-panel" id="account-menu-panel" data-account-menu-panel aria-label="Account options" hidden>
            <div class="account-menu-summary">
                <span class="account-avatar account-avatar-large">
                    <span class="account-avatar-fallback" aria-hidden="true">@displayName[0].ToString().ToUpperInvariant()</span>
                    @if (!isAdmin)
                    {
                        <img src="@(Url.Action("Avatar", "Profile", new { version = DateTimeOffset.UtcNow.ToUnixTimeSeconds() }) ?? "/profile/avatar")" alt="" onerror="this.hidden=true;" />
                    }
                </span>
                <span><strong>@displayName</strong><small>@(isAdmin ? "Owner account" : "ApplyWise account")</small></span>
            </div>
            <div class="account-menu-links">
                @if (isAdmin)
                {
                    <a asp-controller="Admin" asp-action="Index">Owner console</a>
                    <a asp-controller="Dashboard" asp-action="Settings">Owner security</a>
                }
                else
                {
                    <a asp-controller="Profile" asp-action="Index">My profile</a>
                    <a asp-controller="Dashboard" asp-action="Settings">Settings</a>
                }
            </div>
            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit">Log out</button>
            </form>
        </div>
    </div>
} else {
    <a class="btn btn-link" asp-area="Identity" asp-page="/Account/Login">Log in</a><a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Register">Create account</a>
}
</div>
