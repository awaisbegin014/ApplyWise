@model ApplyWise.Web.ViewModels.Admin.AdminContactMessageViewModel
@using ApplyWise.Web.Services.Security
@{
    ViewData["Title"] = "Contact message";
    ViewData["MetaDescription"] = "Private ApplyWise contact-message detail.";
    var senderMailto = MailtoLinkBuilder.Build(Model.Email);
    var replyMailto = MailtoLinkBuilder.Build(Model.Email, $"Re: {Model.Subject}");
    var nextReadState = (!Model.IsRead).ToString().ToLowerInvariant();
}

<div class="admin-dashboard admin-user-report admin-contact-detail">
    <a class="admin-back-link" asp-action="ContactMessages">← Back to contact inbox</a>

    <section class="page-heading admin-heading admin-report-heading">
        <div>
            <span class="eyebrow">Contact message #@Model.Id</span>
            <h1>@Model.Subject</h1>
            <p>Received from @Model.FullName on @Model.CreatedAt.ToUniversalTime().ToString("MMM d, yyyy 'at' h:mm tt 'UTC'").</p>
        </div>
        <div class="admin-report-badges"><span class="badge @(Model.IsRead ? "badge-neutral" : "badge-warning")">@(Model.IsRead ? "Read" : "Unread")</span></div>
    </section>

    <section class="admin-content-grid admin-contact-detail-grid">
        <article class="panel admin-report-panel">
            <header class="panel-heading"><div><span class="eyebrow">Sender</span><h3>Contact details</h3></div></header>
            <dl class="admin-detail-list">
                <div><dt>Name</dt><dd>@Model.FullName</dd></div>
                <div><dt>Email</dt><dd><a href="@senderMailto">@Model.Email</a></dd></div>
                <div><dt>Topic</dt><dd>@Model.Topic</dd></div>
                <div><dt>Account link</dt><dd>@(Model.UserId is null ? "Anonymous or not linked" : "Submitted while signed in")</dd></div>
                <div><dt>Received</dt><dd><time datetime="@Model.CreatedAt.ToString("O")">@Model.CreatedAt.ToUniversalTime().ToString("MMM d, yyyy h:mm tt 'UTC'")</time></dd></div>
                <div><dt>Read</dt><dd>@(Model.ReadAt?.ToUniversalTime().ToString("MMM d, yyyy h:mm tt 'UTC'") ?? "Not yet")</dd></div>
            </dl>
        </article>

        <article class="panel admin-report-panel admin-contact-actions-panel">
            <header class="panel-heading"><div><span class="eyebrow">Actions</span><h3>Respond or organize</h3></div></header>
            <a class="btn btn-primary" href="@replyMailto">Reply by email</a>
            <form asp-action="SetContactMessageReadState" asp-route-id="@Model.Id" method="post">
                <input type="hidden" name="isRead" value="@nextReadState" />
                <button class="btn btn-outline-primary" type="submit">@(Model.IsRead ? "Mark as unread" : "Mark as read")</button>
            </form>
            <p>Read state is private to the owner console and does not notify the sender.</p>
        </article>
    </section>

    <section class="panel admin-report-panel admin-contact-message-panel" aria-labelledby="admin-contact-message-title">
        <header class="panel-heading"><div><span class="eyebrow">Message</span><h3 id="admin-contact-message-title">@Model.Subject</h3></div></header>
        <div class="admin-contact-message">@Model.Body</div>
    </section>

    <p class="admin-privacy-note"><strong>Handle with care.</strong> This message was submitted for support or feedback. Use it only to answer the request and operate ApplyWise.</p>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}
