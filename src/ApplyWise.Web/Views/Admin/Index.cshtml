@model ApplyWise.Web.ViewModels.Admin.AdminDashboardViewModel
@{
    ViewData["Title"] = "Owner dashboard";
    ViewData["MetaDescription"] = "Private operational metrics for the ApplyWise owner.";
    var maximumDailyEvents = Math.Max(1, Model.DailyActivity.Max(day => day.Events));
    var selectedDays = Model.Range switch
    {
        "Last 7 days" => 7,
        "Last 90 days" => 90,
        _ => 30
    };
}

<div class="admin-dashboard">
    <section class="page-heading admin-heading">
        <div>
            <span class="eyebrow">Private owner console</span>
            <h1>Product health</h1>
            <p>Account, engagement, and feature metrics with secure per-user operational reports.</p>
        </div>
        <form method="get" class="admin-range-form">
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <input type="hidden" name="search" value="@Model.Search" />
            }
            <label for="days">Reporting range</label>
            <select id="days" name="days" class="form-select" onchange="this.form.submit()">
                @foreach (var range in new[] { 7, 30, 90 })
                {
                    if (Model.Range == $"Last {range} days")
                    {
                        <option value="@range" selected>Last @range days</option>
                    }
                    else
                    {
                        <option value="@range">Last @range days</option>
                    }
                }
            </select>
        </form>
    </section>

    <section class="admin-metric-grid" aria-label="Account metrics">
        <article class="metric-card admin-metric-card">
            <span>Total users</span><strong>@Model.TotalUsers</strong>
            <small>@Model.NewUsersInRange new in this range</small>
        </article>
        <article class="metric-card admin-metric-card">
            <span>Active users</span><strong>@Model.ActiveUsersInRange</strong>
            <small>Activity recorded in this range</small>
        </article>
        <article class="metric-card admin-metric-card">
            <span>Email confirmation</span><strong>@Model.ConfirmationRate.ToString("0.#")%</strong>
            <small>@Model.ConfirmedUsers of @Model.TotalUsers accounts</small>
        </article>
        <article class="metric-card admin-metric-card">
            <span>Onboarding completion</span><strong>@Model.OnboardingRate.ToString("0.#")%</strong>
            <small>@Model.CompletedOnboardingUsers completed</small>
        </article>
    </section>

    <section class="admin-content-grid">
        <article class="panel admin-activity-panel">
            <header class="panel-heading">
                <div><span class="eyebrow">Engagement</span><h3>Daily activity</h3></div>
                <small>UTC · @Model.Range</small>
            </header>
            <div class="admin-chart" role="img" aria-label="Daily product event activity">
                @foreach (var day in Model.DailyActivity)
                {
                    var height = Math.Max(3, day.Events * 100d / maximumDailyEvents);
                    <div class="admin-chart-column" title="@day.Date.ToString("MMM d"): @day.Events events, @day.ActiveUsers active users, @day.Signups signups">
                        <div class="admin-chart-bar" style="height:@height.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                        <span>@day.Date.ToString(Model.DailyActivity.Count <= 7 ? "ddd" : "dd")</span>
                    </div>
                }
            </div>
            <div class="admin-chart-legend">
                <span><i></i> Persisted product events</span>
                <span>@Model.FailedEventsInRange failed event@(Model.FailedEventsInRange == 1 ? string.Empty : "s")</span>
            </div>
        </article>

        <article class="panel admin-feature-panel">
            <header class="panel-heading">
                <div><span class="eyebrow">Adoption</span><h3>Feature usage</h3></div>
            </header>
            @if (Model.FeatureUsage.Count == 0)
            {
                <div class="admin-empty"><strong>No events yet</strong><span>New activity will appear after this release is used.</span></div>
            }
            else
            {
                <div class="admin-feature-list">
                    @foreach (var item in Model.FeatureUsage)
                    {
                        <div>
                            <span><strong>@item.Label</strong><small>@item.UniqueUsers unique user@(item.UniqueUsers == 1 ? string.Empty : "s")</small></span>
                            <b>@item.Count</b>
                        </div>
                    }
                </div>
            }
        </article>
    </section>

    <section class="admin-object-grid" aria-label="Operational totals">
        <article class="panel"><span>Applications</span><strong>@Model.TotalApplications</strong></article>
        <article class="panel"><span>Resumes</span><strong>@Model.TotalResumes</strong></article>
        <article class="panel"><span>Analyses</span><strong>@Model.TotalAnalyses</strong></article>
        <article class="panel"><span>Interviews</span><strong>@Model.TotalInterviews</strong></article>
        <a class="panel admin-contact-object" asp-action="ContactMessages">
            <span>Contact inbox<small>@Model.TotalContactMessages total</small></span>
            <strong>@Model.UnreadContactMessages<small> unread</small></strong>
        </a>
    </section>

    <section class="panel admin-contact-preview-panel">
        <header class="panel-heading">
            <div><span class="eyebrow">Support</span><h3>Recent contact messages</h3></div>
            <a class="btn btn-outline-primary btn-sm" asp-action="ContactMessages">Open inbox</a>
        </header>
        @if (Model.RecentContactMessages.Count == 0)
        {
            <div class="admin-empty admin-compact-empty"><strong>No contact messages yet</strong><span>Messages from the public Contact Us page will appear here.</span></div>
        }
        else
        {
            <div class="admin-contact-preview-list">
                @foreach (var message in Model.RecentContactMessages)
                {
                    <a class="@(message.IsRead ? null : "is-unread")" asp-action="ContactMessage" asp-route-id="@message.Id">
                        <span class="admin-contact-status-dot" aria-hidden="true"></span>
                        <span><strong>@message.Subject</strong><small>@message.FullName · @message.Email · @message.Topic</small></span>
                        <time datetime="@message.CreatedAt.ToString("O")">@message.CreatedAt.ToUniversalTime().ToString("MMM d, h:mm tt 'UTC'")</time>
                        <span class="badge @(message.IsRead ? "badge-neutral" : "badge-warning")">@(message.IsRead ? "Read" : "Unread")</span>
                    </a>
                }
            </div>
        }
    </section>

    <section class="panel admin-users-panel">
        <header class="panel-heading">
            <div><span class="eyebrow">Accounts</span><h3>Recent users</h3></div>
            <small>@Model.TotalMatchingUsers matching · page @Model.UserPage of @Model.TotalUserPages · UTC</small>
        </header>
        <form method="get" class="admin-user-search" role="search">
            <input type="hidden" name="days" value="@selectedDays" />
            <label class="visually-hidden" for="admin-user-search">Search users by name or email</label>
            <input id="admin-user-search" class="form-control" type="search" name="search" value="@Model.Search" maxlength="320" placeholder="Search by name or email" />
            <button class="btn btn-primary" type="submit">Search</button>
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <a class="btn btn-outline-secondary" asp-action="Index" asp-route-days="@selectedDays">Clear</a>
            }
        </form>
        <div class="table-responsive">
            <table class="table app-table admin-user-table">
                <caption class="visually-hidden">ApplyWise user accounts and usage totals</caption>
                <thead>
                    <tr><th>User</th><th>Joined</th><th>Last active</th><th>Account</th><th>Usage</th><th><span class="visually-hidden">Actions</span></th></tr>
                </thead>
                <tbody>
                    @if (Model.Users.Count == 0)
                    {
                        <tr><td colspan="6"><div class="admin-empty admin-compact-empty"><strong>No users found</strong><span>Try a different name or email.</span></div></td></tr>
                    }
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td data-label="User"><div class="admin-user-identity"><strong>@user.DisplayName</strong><span>@user.Email</span></div></td>
                            <td data-label="Joined"><time datetime="@user.RegisteredAt.ToString("O")">@(user.RegisteredAt == DateTimeOffset.MinValue ? "Before tracking" : user.RegisteredAt.ToUniversalTime().ToString("MMM d, yyyy 'UTC'"))</time></td>
                            <td data-label="Last active">
                                @if (user.LastActivityAt.HasValue)
                                {
                                    <time datetime="@user.LastActivityAt.Value.ToString("O")">@user.LastActivityAt.Value.ToUniversalTime().ToString("MMM d, h:mm tt 'UTC'")</time>
                                }
                                else
                                {
                                    <span class="admin-muted">Not recorded</span>
                                }
                            </td>
                            <td data-label="Account">
                                <span class="badge @(user.EmailConfirmed ? "badge-success" : "badge-warning")">@(user.EmailConfirmed ? "Confirmed" : "Unconfirmed")</span>
                                <small class="admin-account-detail">@(user.OnboardingCompleted ? "Onboarded" : "Onboarding incomplete") · @user.SuccessfulLogins login@(user.SuccessfulLogins == 1 ? string.Empty : "s")</small>
                            </td>
                            <td data-label="Usage"><span class="admin-usage-counts">@user.ResumeCount resumes · @user.AnalysisCount analyses · @user.ApplicationCount applications · @user.InterviewCount interviews</span></td>
                            <td data-label="Action"><a class="btn btn-outline-primary btn-sm admin-report-link" asp-action="UserDetails" asp-route-userId="@user.UserId">View report</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <nav class="admin-pagination" aria-label="User account pages">
            @if (Model.HasPreviousUserPage)
            {
                <a class="btn btn-outline-primary btn-sm" asp-action="Index" asp-route-days="@selectedDays" asp-route-search="@Model.Search" asp-route-page="@(Model.UserPage - 1)">← Previous</a>
            }
            <span>Showing page @Model.UserPage of @Model.TotalUserPages</span>
            @if (Model.HasNextUserPage)
            {
                <a class="btn btn-outline-primary btn-sm" asp-action="Index" asp-route-days="@selectedDays" asp-route-search="@Model.Search" asp-route-page="@(Model.UserPage + 1)">Next →</a>
            }
        </nav>
    </section>

    <p class="admin-generated">Generated @Model.GeneratedAt.ToUniversalTime().ToString("MMM d, yyyy 'at' h:mm:ss tt 'UTC'") · Product events are retained for a limited period.</p>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}
