@{
    ViewData["Title"] = "Support";
    ViewData["MetaDescription"] = "Get account, privacy, and technical support for ApplyWise.";
}
<section class="public-info-card">
    <span class="eyebrow">Support</span>
    <h1>How can we help?</h1>
    <p>Use the <a asp-controller="Contact" asp-action="Index">Contact Us form</a> for account, privacy, or technical support. Your message will appear directly in the protected owner inbox.</p>
    <div class="public-info-grid">
        <div><h2>Account access</h2><p>Use the Forgot password link first. If email confirmation or recovery still fails, include the account email address but never send your password or authentication codes.</p></div>
        <div><h2>Technical issue</h2><p>Describe what you expected, what happened, the page involved, browser, and approximate time. Remove resume text and other sensitive information from screenshots.</p></div>
        <div><h2>Privacy request</h2><p>Ask for access, correction, deletion assistance, or information about how your data is handled. Identity verification may be required before account information is disclosed.</p></div>
    </div>
    <p class="public-info-note">For security incidents involving an ApplyWise account, choose Technical support, use the subject “Security issue,” and contact us promptly.</p>
</section>
