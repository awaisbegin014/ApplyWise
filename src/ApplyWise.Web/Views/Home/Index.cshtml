@{
    ViewData["Title"] = "Track every opportunity and apply with the right resume";
    ViewData["MetaDescription"] = "Track every job application, compare evidence against real requirements, and build parser-friendly resumes in one focused ApplyWise workspace.";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<main id="main-content" class="aw-home" role="main">
    <section class="aw-home-hero" aria-labelledby="home-hero-title">
        <div class="aw-home-container aw-home-hero-grid">
            <div class="aw-home-hero-copy">
                <span class="aw-home-kicker aw-home-hero-kicker">Your private career workspace</span>
                <h1 id="home-hero-title">Track every opportunity. <span>Apply with the right resume.</span></h1>
                <p class="aw-home-lead">Keep roles, deadlines, interviews, and the resume you sent in one clear place. Always know the next useful step.</p>
                <div class="aw-home-hero-actions" aria-label="Get started with ApplyWise">
                    <a class="btn btn-primary btn-lg" asp-area="Identity" asp-page="/Account/Register">Start tracking free</a>
                    <a class="btn btn-secondary-soft btn-lg" href="#product-workflow">Explore the workspace</a>
                </div>
                <p class="aw-home-assurance">
                    <span class="aw-home-assurance-mark" aria-hidden="true">&#10003;</span>
                    <span><strong>Private by design.</strong> Resume analysis uses local, explainable rules and does not send your resume text to an external AI service. <a asp-controller="Home" asp-action="Privacy">Read our privacy approach</a>.</span>
                </p>
            </div>

            <figure class="aw-home-wiso-visual">
                <div class="aw-home-wiso-stage">
                    <picture>
                        <source type="image/webp"
                                srcset="@Url.Content("~/images/wiso-standalone-480.webp") 480w, @Url.Content("~/images/wiso-standalone-768.webp") 768w"
                                sizes="(max-width: 600px) 430px, 610px" />
                        <img src="~/images/wiso-standalone.png"
                             width="1254"
                             height="1254"
                             decoding="async"
                             fetchpriority="high"
                             alt="Wiso, the ApplyWise career guide, holding a resume checklist" />
                    </picture>
                </div>
                <figcaption class="visually-hidden">Wiso, the ApplyWise guide for organized applications and focused resumes.</figcaption>
            </figure>
        </div>
    </section>

    <section class="aw-home-section aw-home-services" id="features" aria-labelledby="services-title">
        <div class="aw-home-container">
            <header class="aw-home-section-heading">
                <span class="aw-home-kicker">One connected workspace</span>
                <h2 id="services-title">Three tools that work like one system</h2>
                <p>Organize the search, compare resume evidence, and create a focused version without losing the story of each application.</p>
            </header>

            <div class="aw-home-service-grid">
                <article class="aw-home-service-card" id="job-tracker">
                    <div class="aw-home-service-icon"><svg class="ui-icon" aria-hidden="true"><use href="#i-briefcase" /></svg></div>
                    <span class="aw-home-card-number">01</span>
                    <h3>Track opportunities</h3>
                    <p>See every role, status, deadline, interview, and follow-up in context.</p>
                    <ul class="aw-home-feature-points" aria-label="Job tracker features">
                        <li>Visual pipeline</li>
                        <li>Clear next actions</li>
                        <li>Sent-resume history</li>
                    </ul>
                    <a class="aw-home-card-link" asp-controller="Home" asp-action="JobTracker" aria-label="Learn more about the job tracker">Explore job tracker <span aria-hidden="true">&rarr;</span></a>
                </article>

                <article class="aw-home-service-card" id="resume-match">
                    <div class="aw-home-service-icon"><svg class="ui-icon" aria-hidden="true"><use href="#i-match" /></svg></div>
                    <span class="aw-home-card-number">02</span>
                    <h3>Compare resume evidence</h3>
                    <p>Find the strongest saved version and understand important requirement gaps.</p>
                    <ul class="aw-home-feature-points" aria-label="Resume matching features">
                        <li>Job match estimate</li>
                        <li>Matched requirements</li>
                        <li>Practical improvements</li>
                    </ul>
                    <a class="aw-home-card-link" asp-controller="ResumeAnalyzer" asp-action="Index" aria-label="Open ATS and job matching">Open ATS &amp; job match <span aria-hidden="true">&rarr;</span></a>
                </article>

                <article class="aw-home-service-card" id="resume-builder">
                    <div class="aw-home-service-icon"><svg class="ui-icon" aria-hidden="true"><use href="#i-edit-file" /></svg></div>
                    <span class="aw-home-card-number">03</span>
                    <h3>Build a focused resume</h3>
                    <p>Create a professional, parser-friendly resume with a live A4 preview.</p>
                    <ul class="aw-home-feature-points" aria-label="Resume builder features">
                        <li>Guided sections</li>
                        <li>Local draft saving</li>
                        <li>Selectable-text PDF</li>
                    </ul>
                    <a class="aw-home-card-link" asp-controller="Home" asp-action="ResumeBuilder" aria-label="Learn more about the resume builder">Explore resume builder <span aria-hidden="true">&rarr;</span></a>
                </article>
            </div>
        </div>
    </section>

    <section class="aw-home-section aw-home-process" id="how-it-works" aria-labelledby="process-title">
        <div class="aw-home-container aw-home-process-grid" id="product-workflow">
            <header class="aw-home-section-heading">
                <span class="aw-home-kicker">A calmer workflow</span>
                <h2 id="process-title">Move from opportunity to interview with less guesswork</h2>
                <p>ApplyWise keeps the decision and the next action attached to the role.</p>
                <a class="aw-home-process-link" asp-controller="Home" asp-action="HowItWorks">See the complete workflow <span aria-hidden="true">&rarr;</span></a>
            </header>
            <ol class="aw-home-process-list">
                <li>
                    <div class="aw-home-step-marker"><span>1</span><svg class="ui-icon" aria-hidden="true"><use href="#i-briefcase" /></svg></div>
                    <div><h3>Capture the role</h3><p>Save the source, deadline, and next action.</p></div>
                </li>
                <li>
                    <div class="aw-home-step-marker"><span>2</span><svg class="ui-icon" aria-hidden="true"><use href="#i-match" /></svg></div>
                    <div><h3>Choose your evidence</h3><p>Compare versions or build a stronger fit.</p></div>
                </li>
                <li>
                    <div class="aw-home-step-marker"><span>3</span><svg class="ui-icon" aria-hidden="true"><use href="#i-arrow" /></svg></div>
                    <div><h3>Keep momentum</h3><p>Record what you sent and follow up on time.</p></div>
                </li>
            </ol>
        </div>
    </section>

    <section class="aw-home-section aw-home-faq" id="faq" aria-labelledby="faq-title">
        <div class="aw-home-container aw-home-faq-grid">
            <header class="aw-home-section-heading">
                <span class="aw-home-kicker">Frequently asked questions</span>
                <h2 id="faq-title">Clear answers before you start</h2>
                <p>What ApplyWise does, how matching works, and what stays under your control.</p>
                <a class="aw-home-faq-support" asp-controller="Contact" asp-action="Index">Need more help? Contact us <span aria-hidden="true">&rarr;</span></a>
            </header>

            <div class="aw-home-faq-list">
                <details class="aw-home-faq-item" open>
                    <summary><span>What can I track in ApplyWise?</span><span class="aw-home-faq-icon" aria-hidden="true">+</span></summary>
                    <div class="aw-home-faq-answer"><p>Keep each role, source, status, deadline, next action, interview, and the resume you sent connected in one workspace.</p></div>
                </details>

                <details class="aw-home-faq-item">
                    <summary><span>Can I save and compare multiple resume versions?</span><span class="aw-home-faq-icon" aria-hidden="true">+</span></summary>
                    <div class="aw-home-faq-answer"><p>Yes. Save multiple resumes, compare them against a job description, and link the version you choose to that application&rsquo;s history.</p></div>
                </details>

                <details class="aw-home-faq-item">
                    <summary><span>How does resume matching work?</span><span class="aw-home-faq-icon" aria-hidden="true">+</span></summary>
                    <div class="aw-home-faq-answer"><p>ApplyWise uses local, deterministic rules to compare your resume with the job description and explain matched or missing requirements. The result is an estimate, not an employer&rsquo;s actual ATS score.</p></div>
                </details>

                <details class="aw-home-faq-item">
                    <summary><span>Does ApplyWise send my resume text to an external AI service?</span><span class="aw-home-faq-icon" aria-hidden="true">+</span></summary>
                    <div class="aw-home-faq-answer"><p>No. In this release, resume analysis uses local, explainable rules. Uploaded resumes are stored outside the public web root and require authentication plus an ownership check to retrieve.</p></div>
                </details>

                <details class="aw-home-faq-item">
                    <summary><span>Can I build and download a PDF resume?</span><span class="aw-home-faq-icon" aria-hidden="true">+</span></summary>
                    <div class="aw-home-faq-answer"><p>Yes. The guided builder includes a live preview and creates a text-based, selectable PDF that you can download and use for applications.</p></div>
                </details>

                <details class="aw-home-faq-item">
                    <summary><span>Does a match estimate guarantee an interview?</span><span class="aw-home-faq-icon" aria-hidden="true">+</span></summary>
                    <div class="aw-home-faq-answer"><p>No. Scores and suggestions are informational estimates. They cannot predict or guarantee an interview, an offer, or any hiring outcome.</p></div>
                </details>
            </div>
        </div>
    </section>

    <section class="aw-home-section aw-home-final-cta" aria-labelledby="final-cta-title">
        <div class="aw-home-container">
            <div class="aw-home-cta-card">
                <div>
                    <span class="aw-home-kicker">Your next step</span>
                    <h2 id="final-cta-title">Give every application a clear next move.</h2>
                    <p>Start a private workspace and bring your search into focus.</p>
                </div>
                <div class="aw-home-cta-actions">
                    <a class="btn btn-primary btn-lg" asp-area="Identity" asp-page="/Account/Register">Create your free workspace</a>
                    <a class="aw-home-sign-in-link" asp-area="Identity" asp-page="/Account/Login">Already have an account? Sign in</a>
                </div>
                <p class="aw-home-cta-assurance"><span aria-hidden="true">&#10003;</span><span><strong>Your files stay private to your account.</strong> Local, explainable matching helps you review evidence; estimates never promise an employer outcome.</span></p>
            </div>
        </div>
    </section>
</main>

<partial name="_MarketingFooter" />

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}
