@model ApplyWise.Web.ViewModels.Home.StatusCodeViewModel
@{
    ViewData["Title"] = Model.StatusCode == 404 ? "Page not found" : "Request unavailable";
}

<section class="empty-card error-card" aria-labelledby="status-page-title">
    <span class="empty-icon" aria-hidden="true">@Model.StatusCode</span>
    <h1 id="status-page-title">@Model.Title</h1>
    <p>@Model.Message</p>
    <div class="d-flex flex-wrap justify-content-center gap-2">
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Return to ApplyWise</a>
        <a class="btn btn-secondary-soft" asp-controller="Contact" asp-action="Index">Contact support</a>
    </div>
</section>
