@model ApplyWise.Web.ViewModels.AiCoach.AiCoachViewModel
@{
    ViewData["Title"] = "AI bullet coach";
    ViewData["MetaDescription"] = "Improve a resume bullet with truthful, job-aware AI suggestions.";
    var subscription = Model.Subscription!;
    var usedPercent = subscription.AiLimit == 0
        ? 100
        : Math.Min(100, (subscription.AiUsed + subscription.AiReserved) * 100 / subscription.AiLimit);
}

<div class="aw-ai-page">
    <section class="aw-ai-hero">
        <div>
            <span class="eyebrow">ApplyWise AI</span>
            <h1>Turn one weak bullet into a stronger story.</h1>
            <p>Get concise rewrites grounded only in the facts you provide. ApplyWise will not invent metrics, skills, or experience.</p>
        </div>
        <aside class="aw-ai-quota-card" aria-label="AI usage allowance">
            <span class="aw-plan-pill @(subscription.IsPro ? "is-pro" : null)">@(subscription.IsPro ? "Pro" : "Free trial")</span>
            <strong>@subscription.AiRemaining of @subscription.AiLimit left</strong>
            <div class="aw-quota-track"><span style="width:@usedPercent%"></span></div>
            <small>@(subscription.IsPro ? "Current Pro cycle" : "Lifetime trial allowance")</small>
        </aside>
    </section>

    @if (!Model.AiConfigured)
    {
        <div class="aw-ai-notice" role="status"><strong>AI setup is not active yet.</strong> Add the Gemini server configuration before inviting users to try this feature.</div>
    }

    <section class="aw-ai-workspace">
        <form asp-action="ImproveBullet" method="post" class="panel aw-ai-form">
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <div class="aw-field-heading">
                <label asp-for="Bullet"></label>
                <span>20–700 characters</span>
            </div>
            <textarea asp-for="Bullet" class="form-control" rows="5" placeholder="Example: Helped the development team build features for the company website."></textarea>
            <span asp-validation-for="Bullet" class="field-validation-error"></span>

            <details class="aw-ai-context" @(string.IsNullOrWhiteSpace(Model.JobContext) ? null : "open")>
                <summary>Add job context <span>Optional, but improves relevance</span></summary>
                <label asp-for="JobContext"></label>
                <textarea asp-for="JobContext" class="form-control" rows="5" placeholder="Paste the most relevant responsibility or part of the job description."></textarea>
                <span asp-validation-for="JobContext" class="field-validation-error"></span>
            </details>

            <div class="form-check aw-ai-consent">
                <input asp-for="AiProcessingConsent" class="form-check-input" />
                <label asp-for="AiProcessingConsent" class="form-check-label"></label>
                <span asp-validation-for="AiProcessingConsent" class="field-validation-error"></span>
                <small>Do not include contact details or another person&apos;s private information. See the <a asp-controller="Home" asp-action="Privacy">privacy policy</a>.</small>
            </div>

            <div class="aw-ai-form-footer">
                <span>Only this bullet and optional job context are sent to Gemini.</span>
                <button class="btn btn-primary" type="submit" disabled="@(!Model.AiConfigured || subscription.AiRemaining == 0)">Improve this bullet</button>
            </div>
            @if (!subscription.IsPro && subscription.AiRemaining == 0)
            {
                <a class="aw-ai-upgrade-inline" asp-controller="Subscriptions" asp-action="Index">Your free trials are complete. See Pro access →</a>
            }
        </form>

        <aside class="panel aw-ai-guidance">
            <span class="eyebrow">For a useful result</span>
            <h2>Include real evidence.</h2>
            <ul>
                <li>What did you build, improve, or deliver?</li>
                <li>Which tools did you actually use?</li>
                <li>Who benefited from the work?</li>
                <li>Do you have a verified number or outcome?</li>
            </ul>
            <p>If a fact is missing, the coach asks for it instead of making it up.</p>
        </aside>
    </section>

    @if (Model.Result is not null)
    {
        <section class="aw-ai-result" aria-live="polite">
            <header>
                <span class="eyebrow">AI coaching result</span>
                <h2>@Model.Result.Headline</h2>
                <p>@Model.Result.Assessment</p>
            </header>
            <div class="aw-rewrite-grid">
                @for (var index = 0; index < Model.Result.Rewrites.Count; index++)
                {
                    var rewrite = Model.Result.Rewrites[index];
                    <article class="panel aw-rewrite-card">
                        <span>Option @(index + 1)</span>
                        <blockquote>@rewrite.Text</blockquote>
                        <p>@rewrite.Rationale</p>
                    </article>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Result.MissingContextQuestion))
            {
                <div class="aw-ai-question"><strong>Make it even better</strong><span>@Model.Result.MissingContextQuestion</span></div>
            }
            <p class="aw-ai-truth-note">@Model.Result.TruthfulnessNote Review every suggestion before using it.</p>
        </section>
    }
</div>

@section Styles { <link rel="stylesheet" href="~/css/subscriptions-ai.css" asp-append-version="true" /> }
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
